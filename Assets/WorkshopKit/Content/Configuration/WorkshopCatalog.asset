%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 909c43bcb2643bf4380ca920c9aaf0b1, type: 3}
  m_Name: WorkshopCatalog
  m_EditorClassIdentifier: UnityWorkshop.Editor::UnityWorkshop.WorkshopCatalog
  entries:
  - displayName: Floor Tile
    description: "A 4 \xD7 4 m floor square. Snap tiles together to make the ground."
    constraints: Snaps to a 4 m grid.
    prefab: {fileID: 4823205852682257638, guid: 54108d59d61bbbd4282d31499db67987, type: 3}
    category: 0
    gridSize: 4
    groupName: Environment
  - displayName: Floor Tile (Dark)
    description: The same floor in a darker shade, for patterns and paths.
    constraints: Snaps to a 4 m grid.
    prefab: {fileID: 7694296716080097567, guid: ad62d0596f9a18b4c80bb529cddd437e, type: 3}
    category: 0
    gridSize: 4
    groupName: Environment
  - displayName: Low Wall 4 m
    description: A knee-high wall the camera can see over. Rotate with E to turn
      corners.
    constraints: Snaps to a 1 m grid.
    prefab: {fileID: 6789985838039006493, guid: c3c59d0b70b134f409c27b5fa0a75cc4, type: 3}
    category: 0
    gridSize: 1
    groupName: Environment
  - displayName: Low Wall 2 m
    description: A short knee-high wall for gaps and corners.
    constraints: Snaps to a 1 m grid.
    prefab: {fileID: 3502387655003893185, guid: 522149982d5e1294c9629b1cdd224885, type: 3}
    category: 0
    gridSize: 1
    groupName: Environment
  - displayName: Boundary Wall 4 m
    description: A taller edge wall that keeps players inside the level.
    constraints: Snaps to a 1 m grid.
    prefab: {fileID: 7725941403212842544, guid: 62f6617bb1ab35b428543249cf5f18f9, type: 3}
    category: 0
    gridSize: 1
    groupName: Environment
  - displayName: Gem
    description: A collectible. Touch it to pick it up. Counts toward Collect All,
      Then Exit.
    constraints: Restart brings it back; respawning keeps it collected.
    prefab: {fileID: 8955004232708137143, guid: 7680649209bdb1942982c58d3bb1d82a, type: 3}
    category: 2
    gridSize: 1
    groupName: Gameplay
  - displayName: Exit Goal
    description: Walk in to win once the rule in Game Setup is met.
    constraints: Shows grey while locked and green when open.
    prefab: {fileID: 5332358816054809441, guid: a698b3d71870d554a8d3112814687ef9, type: 3}
    category: 2
    gridSize: 1
    groupName: Gameplay
  - displayName: Start Point
    description: Where the player begins and respawns. A game has exactly one.
    constraints: Use the blue ring to change which way the player faces.
    prefab: {fileID: 8277881659856750751, guid: ed937152d7aef7c4eb70549494aff652, type: 3}
    category: 2
    gridSize: 1
    groupName: Gameplay
  - displayName: Spike Trap
    description: Touching it sends the player back to the start.
    constraints: "Items and time are kept. 2 \xD7 2 m."
    prefab: {fileID: 5637721247444045883, guid: 94455271060efb441a407f21f9c194a1, type: 3}
    category: 3
    gridSize: 1
    groupName: Gameplay
  - displayName: Crate
    description: A 1 m wooden box. Solid; use it as an obstacle.
    constraints: 
    prefab: {fileID: 5877081718378174828, guid: cb07849bcded3c84d859a76c254788ef, type: 3}
    category: 5
    gridSize: 1
    groupName: Decoration
  - displayName: Tree
    description: A tree. Only the trunk is solid.
    constraints: 
    prefab: {fileID: 2539787300344328491, guid: 0803bf1ba0b520d489533e3a5ad79687, type: 3}
    category: 5
    gridSize: 1
    groupName: Decoration
  - displayName: Rock
    description: A low rock. Solid.
    constraints: 
    prefab: {fileID: 5525971135576004224, guid: 73b62862ee4dd804793bc7cc2d6c7a8f, type: 3}
    category: 5
    gridSize: 0.5
    groupName: Decoration
  - displayName: Moving Spikes
    description: Spikes that slide back and forth. Touching them sends the player
      back.
    constraints: 'Drag the orange end handle to set the path. Speed: Slow, Medium
      or Fast.'
    prefab: {fileID: 5624685249635503254, guid: 9df3d48ef734b104ead8a553d4e46e9a, type: 3}
    category: 3
    gridSize: 1
    groupName: Gameplay
  - displayName: Fall Zone
    description: An invisible area that counts as falling out of the level, for pits
      and gaps.
    constraints: Invisible in the game. Resize with the purple handles.
    prefab: {fileID: 3870960687359770655, guid: be3a1c54c5f90e144a5edce301773282, type: 3}
    category: 3
    gridSize: 1
    groupName: Gameplay
  - displayName: Checkpoint
    description: Touch it to make it your respawn point. Items and time are kept.
    constraints: Restart clears it. Use the green ring to set the respawn facing.
    prefab: {fileID: 2762521951637217969, guid: 92467d8f5aea95041a242d13a01150fc, type: 3}
    category: 4
    gridSize: 1
    groupName: Gameplay
  - displayName: Key
    description: Opens every door with the same colour and symbol, for good.
    constraints: Choose Red, Blue, Green or Yellow in the Inspector.
    prefab: {fileID: 775449952671556753, guid: a4ef767fe788f414292bc4ba0d6b3a7d, type: 3}
    category: 4
    gridSize: 1
    groupName: Gameplay
  - displayName: Door
    description: Blocks the way until a key or switch with the same colour and symbol
      opens it.
    constraints: 2 m wide. Never closes on the player.
    prefab: {fileID: 9112034889682881493, guid: 3581276c0660c8c4d8a97748cd9c9adc, type: 3}
    category: 4
    gridSize: 1
    groupName: Gameplay
  - displayName: Pressure Switch
    description: Stand on it to open doors with the same colour and symbol.
    constraints: Doors close when you step off, unless Latch is on.
    prefab: {fileID: 3532541747379159123, guid: 7530778a8b7c5a64b9a97f7d24601e5c, type: 3}
    category: 4
    gridSize: 1
    groupName: Gameplay
  - displayName: Tall Wall 4 m
    description: A 3 m wall nobody can see or jump over. Builds real mazes in first-
      and third-person.
    constraints: Hidden in Top-Down, where it would hide the player.
    prefab: {fileID: 1341868994523116853, guid: 8f6870ee7a095b140a7f2be0d487c747, type: 3}
    category: 0
    gridSize: 1
    groupName: Environment
  - displayName: Tall Wall 2 m
    description: A short 3 m wall for gaps and corners.
    constraints: Hidden in Top-Down, where it would hide the player.
    prefab: {fileID: 5379300079748892170, guid: d823b47beef742b44853046023d7d73e, type: 3}
    category: 0
    gridSize: 1
    groupName: Environment
  - displayName: Raised Platform
    description: "A 2 \xD7 2 m block 1 m high. Jump on to reach things."
    constraints: Only offered in templates that can jump.
    prefab: {fileID: 7977573932820042594, guid: dfbb09dd570e60840968b0e8447d8cbe, type: 3}
    category: 0
    gridSize: 1
    groupName: Environment
  - displayName: Floating Platform
    description: "A 3 \xD7 3 m slab that floats where you put it. Jump between them
      to cross gaps."
    constraints: Only offered in templates that can jump. Its top is where you place
      it.
    prefab: {fileID: 2901776791201398154, guid: 24c204c12f34dd4419fdfef0b6811c55, type: 3}
    category: 0
    gridSize: 0.5
    groupName: Environment
